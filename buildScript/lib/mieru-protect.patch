+//go:build android
+
+package sockopts
+
+import (
+	"net"
+	"syscall"
+	"testing"
+	"time"
+)
+
+func TestDefaultDialerControlRequiresSuccessfulProtection(t *testing.T) {
+	for _, test := range []struct {
+		name    string
+		reply   []byte
+		failure bool
+	}{
+		{"closed", nil, true},
+		{"refused", []byte{0}, true},
+		{"invalid", []byte{2}, true},
+		{"protected", []byte{1}, false},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			t.Chdir(t.TempDir())
+			t.Setenv("MIERU_PROTECT_PATH", "protect.sock")
+			listener, err := net.ListenUnix("unix", &net.UnixAddr{Name: "protect.sock", Net: "unix"})
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer listener.Close()
+			listener.SetDeadline(time.Now().Add(5 * time.Second))
+			serve := func() error {
+				conn, err := listener.AcceptUnix()
+				if err != nil {
+					return err
+				}
+				defer conn.Close()
+				conn.SetDeadline(time.Now().Add(5 * time.Second))
+				oob := make([]byte, syscall.CmsgSpace(4))
+				_, n, _, _, err := conn.ReadMsgUnix(make([]byte, 1), oob)
+				if err != nil {
+					return err
+				}
+				messages, err := syscall.ParseSocketControlMessage(oob[:n])
+				if err != nil {
+					return err
+				}
+				for _, message := range messages {
+					fds, err := syscall.ParseUnixRights(&message)
+					if err != nil {
+						return err
+					}
+					for _, fd := range fds {
+						syscall.Close(fd)
+					}
+				}
+				if len(test.reply) > 0 {
+					_, err = conn.Write(test.reply)
+				}
+				return err
+			}
+			done := make(chan error, 1)
+			go func() { done <- serve() }()
+			conn, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer conn.Close()
+			raw, err := conn.SyscallConn()
+			if err != nil {
+				t.Fatal(err)
+			}
+			err = DefaultDialerControl()("udp4", "127.0.0.1:443", raw)
+			if (err != nil) != test.failure {
+				t.Errorf("protection error = %v, want failure %v", err, test.failure)
+			}
+			if err := <-done; err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
+
+func TestProtectPathReturnsRawConnFailure(t *testing.T) {
+	conn, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	raw, err := conn.SyscallConn()
+	if err != nil {
+		conn.Close()
+		t.Fatal(err)
+	}
+	conn.Close()
+	if err := ProtectPath("unused.sock")("udp4", "127.0.0.1:443", raw); err == nil {
+		t.Fatal("closed socket control reported success")
+	}
+}
