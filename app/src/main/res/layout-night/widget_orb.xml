<?xml version="1.0" encoding="utf-8"?>
<!-- The night half of widget_orb: the home screen at night shows the night picture. -->
<!-- Not a merge: the frame is the orb's tap target. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_orb"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="48dp"
    android:minHeight="48dp"
    tools:ignore="MergeRootFrame">

    <ImageView
        android:id="@+id/widget_orb_day"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/widget_orb_night"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />
</FrameLayout>
