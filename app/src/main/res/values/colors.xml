    <color name="color_ng_black_surface_variant">#2E2E2E</color>

    <!-- Route rule outbound colors (day). Proxy is blue 800: the 600 shade was under
         4.5:1 as text on the tinted elevated cards. Direct and block reuse
         test_available/test_fail through the routeDirectColor/routeBlockColor attrs. -->
    <color name="color_route_proxy">@color/material_blue_800</color>   <!-- proxy: blue -->
    <color name="color_route_config">#8E24AA</color>  <!-- config: purple -->

    <!-- Connection-test result text on the surface, the 10%-primary selected card and the
         tinted elevated cards: green 900 / red 800 pass 4.5:1 on all; night uses the 400
         tones. The dark schemes override the attrs with their own green/red. -->
    <color name="test_available">@color/material_green_900</color>
    <color name="test_fail">@color/material_red_800</color>


    <!-- Default thin card stroke: ~12% black (low-contrast divider); night value in
         values-night/colors.xml. -->
    <color name="card_stroke">#1F000000</color>

    <!-- M3 colorOutline: neutral mid-gray for borders/dividers on light surfaces.
         Night equivalent in values-night/colors.xml. -->
    <color name="m3_outline">#79747E</color>

    <!-- M3 colorSurfaceVariant (light #E7E0EC / night #49454F): switch tracks and other
         surface-variant fills need a real tone, not the surface itself. -->
    <color name="m3_surface_variant">#E7E0EC</color>

    <!-- Text-safe tones for hues whose own 900 shade stays under 4.5:1 on the light
