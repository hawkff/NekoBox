<?xml version="1.0" encoding="utf-8"?>
<!-- About as a colophon: the name and what the app is, the parts it runs on, how to update and
     where the project lives, and the cat with its ramen closing the page. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Declared first so the bars draw over it. It sits below them; with liquid glass it fills the
         screen and the page scrolls beneath them. -->
    <xyz.nekobyte.nekobox.widget.glass.GlassBackdropFrameLayout
        android:id="@+id/glass_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/glass_bars">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/about_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="40dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/app_name"
                    android:textAppearance="?attr/textAppearanceHeadlineMedium" />

                <TextView
                    android:id="@+id/edition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?android:attr/textColorSecondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:maxWidth="320dp"
                    android:text="@string/about_line"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?android:attr/textColorSecondary" />

                <!-- The parts it runs on, label and value. -->
                <!-- The values wrap when the page is narrow or the text large. -->
                <TableLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:shrinkColumns="1">

                    <TableRow>

                        <TextView
                            style="@style/Widget.NekoBox.AboutLabel"
                            android:text="@string/about_core" />

                        <TextView
                            android:id="@+id/core"
                            style="@style/Widget.NekoBox.AboutValue" />

                    </TableRow>

                    <TableRow
                        android:id="@+id/plugins_row"
                        android:layout_marginTop="6dp"
                        android:visibility="gone">

                        <TextView
                            style="@style/Widget.NekoBox.AboutLabel"
                            android:text="@string/about_plugins" />

                        <TextView
                            android:id="@+id/plugins"
                            style="@style/Widget.NekoBox.AboutValue" />

                    </TableRow>

                </TableLayout>

                <TextView
                    android:id="@+id/background"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:paddingHorizontal="12dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?android:attr/textColorSecondary" />

                <!-- Only while Android restricts background use: the one thing on this page that needs doing. -->
                <Button
                    android:id="@+id/allow_background"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_background_allow"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/check_updates"
                    style="@style/Widget.Material3.Button.TextButton.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/about_check_updates"
                    app:icon="@drawable/ic_baseline_update_24" />

                <!-- The project's pages, one per line so they stay centered in any language: each opens the
                     browser, and says so to TalkBack. -->
                <Button
                    android:id="@+id/source"
                    style="@style/Widget.Material3.Button.TextButton.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/github"
                    app:icon="@drawable/ic_open_in_new_24"
                    app:iconGravity="textEnd" />

                <Button
                    android:id="@+id/releases"
                    style="@style/Widget.Material3.Button.TextButton.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_releases"
                    app:icon="@drawable/ic_open_in_new_24"
                    app:iconGravity="textEnd" />

                <Button
                    android:id="@+id/license"
                    style="@style/Widget.Material3.Button.TextButton.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/license"
                    app:icon="@drawable/ic_open_in_new_24"
                    app:iconGravity="textEnd" />

                <!-- Takes up what the page leaves, so the cat sits at the bottom of a short page. -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Content by its ramen, the steam rising; still when animations are off. -->
                <xyz.nekobyte.nekobox.widget.CheckCat
                    android:id="@+id/cat"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="32dp"
                    android:importantForAccessibility="no" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </xyz.nekobyte.nekobox.widget.glass.GlassBackdropFrameLayout>

    <LinearLayout
        android:id="@+id/glass_bars"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical">

        <include
            layout="@layout/layout_appbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>

</RelativeLayout>
