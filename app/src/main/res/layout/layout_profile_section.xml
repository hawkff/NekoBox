<?xml version="1.0" encoding="utf-8"?><!-- A fold over the profiles whose names differ only by a number: its title, how many, and a chevron.
     The type is the section heading's, in the text accent every palette keeps readable; more room above than below sets it off from the row before. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="16dp"
    android:paddingEnd="12dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="?attr/primaryOrTextPrimary"
        tools:text="Countries" />

    <TextView
        android:id="@+id/count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="?android:attr/textColorSecondary"
        tools:text="17" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/chevron"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        app:srcCompat="@drawable/ic_expand_less"
        app:tint="?android:attr/textColorSecondary" />

</LinearLayout>
