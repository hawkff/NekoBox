<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        layout="@layout/layout_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/connection_check_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Waits by its ramen, runs while the check runs. The button says the same in words. -->
            <xyz.nekobyte.nekobox.widget.CheckCat
                android:id="@+id/connection_check_cat"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginBottom="8dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/connection_check_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="12dp"
                android:gravity="center_vertical"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/connection_check_note"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?android:attr/textColorSecondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/connection_check_start"
                style="@style/Widget.NekoBox.Button.Check"
                android:text="@string/connection_check_start"
                app:icon="@drawable/ic_baseline_security_24" />

            <!-- What bash.ws saw, shown as soon as it answers. -->
            <LinearLayout
                android:id="@+id/connection_check_results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/connection_check_verdict"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:drawablePadding="12dp"
                    android:gravity="center_vertical"
                    android:textAppearance="?attr/textAppearanceTitleLarge" />

                <TextView
                    style="@style/Widget.NekoBox.CheckSection"
                    android:accessibilityHeading="true"
                    android:text="@string/connection_check_address"
                    tools:targetApi="p" />

                <LinearLayout
                    android:id="@+id/connection_check_addresses"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    style="@style/Widget.NekoBox.CheckSection"
                    android:accessibilityHeading="true"
                    android:text="@string/connection_check_dns"
                    tools:targetApi="p" />

                <LinearLayout
                    android:id="@+id/connection_check_servers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

            <!-- A failed check, in place of the results. -->
            <TextView
                android:id="@+id/connection_check_failure"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:drawablePadding="12dp"
                android:gravity="center_vertical"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:visibility="gone" />

            <!-- The other findings, in groups under their headings. -->
            <LinearLayout
                android:id="@+id/connection_check_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/connection_check_lookup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/connection_check_proxycheck"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/connection_check_proxycheck" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/connection_check_proxycheck_note"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?android:attr/textColorSecondary" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
