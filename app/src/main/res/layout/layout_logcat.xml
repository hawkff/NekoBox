<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.LogcatFragment">

    <!-- Declared first so the bars draw over it. It sits below them; with liquid glass it fills the
         screen and the log scrolls beneath them. -->
    <xyz.nekobyte.nekobox.widget.glass.GlassBackdropFrameLayout
        android:id="@+id/glass_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/glass_bars">

        <ScrollView
            android:id="@+id/scroolview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp">

            <TextView
                android:id="@+id/textview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:ems="10"
                android:focusable="true"
                android:gravity="start|top"
                android:hint="@string/log_empty"
                android:minHeight="48dp"
                android:textIsSelectable="true"
                tools:ignore="LabelFor" />
        </ScrollView>

    </xyz.nekobyte.nekobox.widget.glass.GlassBackdropFrameLayout>

    <LinearLayout
        android:id="@+id/glass_bars"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical">

        <include
            layout="@layout/layout_appbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>

</RelativeLayout>
