<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:statusBarBackground="@android:color/transparent"
    tools:openDrawer="start">

    <!-- Both record what they draw for liquid glass: the screen for the drawer, the fragment
         for the connect button and the stats bar. -->
    <xyz.nekobyte.nekobox.widget.glass.GlassBackdropCoordinatorLayout
        android:id="@+id/coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false">

        <xyz.nekobyte.nekobox.widget.glass.GlassBackdropCoordinatorLayout
            android:id="@+id/fragment_holder"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <xyz.nekobyte.nekobox.widget.StatsBar
            android:id="@+id/stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:nextFocusUp="@+id/fab"
            app:contentInsetStart="0dp"
            app:fabAlignmentMode="center"
            app:fabAnchorMode="cradle"
            app:hideOnScroll="true"
            app:layout_scrollFlags="enterAlways|scroll">

            <LinearLayout
                android:id="@+id/stats_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tx"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="fill_horizontal"
                    android:ellipsize="marquee"
                    android:singleLine="true"
                    android:textColor="?attr/speedTextColor"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/rx"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="fill_horizontal"
                    android:ellipsize="marquee"
                    android:singleLine="true"
                    android:textColor="?attr/speedTextColor"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:layout_gravity="fill_horizontal"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="16sp"
                    tools:text="@string/connection_test_available" />

            </LinearLayout>

        </xyz.nekobyte.nekobox.widget.StatsBar>

        <!-- The FAB is declared AFTER the StatsBar so the orb draws on top of the bottom bar
             and wins touch in the overlap region. StatsBar opts into the legacy BottomAppBar
             cradle so the centered FAB docks into the bar. -->
        <xyz.nekobyte.nekobox.widget.ServiceButton
            android:id="@+id/fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="6dp"
            android:nextFocusDown="@+id/stats"
            app:backgroundTint="?attr/colorSurfaceContainerHigh"
            app:fabCustomSize="72dp"
            app:layout_anchor="@id/stats"
            app:pressedTranslationZ="6dp" />

    </xyz.nekobyte.nekobox.widget.glass.GlassBackdropCoordinatorLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        style="@style/Widget.Design.NavigationView"
        app:insetForeground="@android:color/transparent"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:itemIconTint="@color/navigation_icon"
        app:itemShapeAppearance="@style/ShapeAppearance.NekoBox.NavItem"
        app:itemShapeFillColor="@color/nav_item_fill"
        app:itemShapeInsetStart="8dp"
        app:itemShapeInsetEnd="8dp"
        app:itemShapeInsetTop="3dp"
        app:itemShapeInsetBottom="3dp"
        app:itemTextColor="@color/navigation_icon" />

</androidx.drawerlayout.widget.DrawerLayout>
