<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Declared first so the bars draw over it. It sits below them; with liquid glass it fills the
         screen and the pages scroll beneath them. -->
    <xyz.nekobyte.nekobox.widget.glass.GlassBackdropFrameLayout
        android:id="@+id/glass_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/glass_bars">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/settings"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </xyz.nekobyte.nekobox.widget.glass.GlassBackdropFrameLayout>

    <LinearLayout
        android:id="@+id/glass_bars"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical">

        <include
            layout="@layout/layout_appbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>

</RelativeLayout>
