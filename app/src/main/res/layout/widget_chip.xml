<?xml version="1.0" encoding="utf-8"?>
<!-- A quick-switch chip of the connect widget: an outlined card's look, 36 dp to see and 48 dp to tap. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_chip"
    android:layout_width="0dp"
    android:layout_height="48dp"
    android:layout_marginHorizontal="@dimen/widget_chip_margin"
    android:layout_weight="1">

    <ImageView
        android:id="@+id/widget_chip_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginVertical="6dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_chip_fill" />

    <ImageView
        android:id="@+id/widget_chip_outline"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginVertical="6dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_chip_outline" />

    <TextView
        android:id="@+id/widget_chip_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:paddingHorizontal="12dp"
        android:singleLine="true"
        android:textSize="14sp" />
</FrameLayout>
