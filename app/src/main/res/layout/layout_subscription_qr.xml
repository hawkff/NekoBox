<?xml version="1.0" encoding="utf-8"?><!-- A subscription's link as a QR code on its cyberpunk card: the name, the code, and who can use it. -->
<xyz.nekobyte.nekobox.widget.CyberCard xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="28dp"
    android:paddingTop="26dp"
    android:paddingEnd="28dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <xyz.nekobyte.nekobox.widget.GlitchText
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:letterSpacing="0.08"
            android:singleLine="true"
            android:textAllCaps="true"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="@color/neon_text"
            android:textStyle="bold"
            tools:text="Night city" />

        <xyz.nekobyte.nekobox.widget.NeonQrView
            android:id="@+id/code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp" />

        <TextView
            android:id="@+id/warning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/subscription_qr_warning"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/neon_magenta" />

    </LinearLayout>

</xyz.nekobyte.nekobox.widget.CyberCard>
