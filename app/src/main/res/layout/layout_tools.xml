<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.ToolsFragment">

    <!-- Declared first so the bars draw over it. It sits below them; with liquid glass it fills the
         screen and the tools scroll beneath them. -->
    <xyz.nekobyte.nekobox.widget.glass.GlassBackdropFrameLayout
        android:id="@+id/glass_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/glass_bars">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/tools_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </xyz.nekobyte.nekobox.widget.glass.GlassBackdropFrameLayout>

    <LinearLayout
        android:id="@+id/glass_bars"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical">

        <include
            layout="@layout/layout_appbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tools_tab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/appBarBackgroundColor"
            android:elevation="0dp"
            app:tabIndicatorColor="?tabIndicatorColor"
            app:tabIndicatorFullWidth="false"
            app:tabMode="fixed"
            app:tabPaddingStart="16dp"
            app:tabRippleColor="?tabRippleColor"
            app:tabSelectedTextColor="?tabSelectedTextColor"
            app:tabTextColor="?tabTextColor"
            app:tabUnboundedRipple="false" />

    </LinearLayout>

</RelativeLayout>
