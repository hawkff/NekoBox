<?xml version="1.0" encoding="utf-8"?>
<!-- The check button's corners tighten under a finger and spring back when it lifts. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true" android:state_pressed="true">
        <objectAnimator
            android:duration="120"
            android:interpolator="@android:interpolator/decelerate_quad"
            android:propertyName="cornerRadius"
            android:valueTo="@dimen/check_button_pressed_corner_radius"
            android:valueType="intType" />
    </item>
    <item>
        <objectAnimator
            android:duration="320"
            android:interpolator="@android:interpolator/overshoot"
            android:propertyName="cornerRadius"
            android:valueTo="@dimen/check_button_corner_radius"
            android:valueType="intType" />
    </item>
</selector>
