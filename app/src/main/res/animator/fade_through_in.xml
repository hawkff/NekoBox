<?xml version="1.0" encoding="utf-8"?>
<!-- The next screen of a fade-through: hidden while the last one fades out, then in, settling from slightly small. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:ordering="together">
    <objectAnimator
        android:duration="0"
        android:propertyName="alpha"
        android:valueFrom="0"
        android:valueTo="0" />
    <objectAnimator
        android:duration="210"
        android:interpolator="@interpolator/ease_out_expo"
        android:propertyName="alpha"
        android:startOffset="90"
        android:valueFrom="0"
        android:valueTo="1" />
    <objectAnimator
        android:duration="210"
        android:interpolator="@interpolator/ease_out_expo"
        android:propertyName="scaleX"
        android:startOffset="90"
        android:valueFrom="0.92"
        android:valueTo="1" />
    <objectAnimator
        android:duration="210"
        android:interpolator="@interpolator/ease_out_expo"
        android:propertyName="scaleY"
        android:startOffset="90"
        android:valueFrom="0.92"
        android:valueTo="1" />
</set>
