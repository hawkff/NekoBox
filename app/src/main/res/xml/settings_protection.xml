<?xml version="1.0" encoding="utf-8"?>
<!-- A Settings page, opened from its row (screen_protection) in global_preferences.xml. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <SwitchPreference
        app:defaultValue="true"
        app:icon="@drawable/ic_security"
        app:key="killSwitch"
        app:summary="@string/kill_switch_summary"
        app:title="@string/kill_switch" />
    <SwitchPreference
        app:defaultValue="false"
        app:icon="@drawable/ic_fingerprint"
        app:key="webrtcLeakProtection"
        app:summary="@string/webrtc_leak_protection_summary"
        app:title="@string/webrtc_leak_protection" />
    <Preference
        app:icon="@drawable/ic_vpn_key"
        app:key="protectionAlwaysOn"
        app:title="@string/protection_always_on" />
    <Preference
        app:icon="@drawable/ic_lock"
        app:key="protectionLockdown"
        app:title="@string/protection_lockdown" />
    <Preference
        app:icon="@drawable/ic_developer_board"
        app:key="protectionBattery"
        app:title="@string/protection_battery" />
    <Preference
        app:icon="@drawable/ic_info"
        app:key="protectionNotes"
        app:selectable="false"
        app:summary="@string/protection_notes"
        app:title="@string/protection_notes_title" />
    <PreferenceCategory app:title="@string/gps_spoofing">
        <SwitchPreference
            app:defaultValue="false"
            app:key="gpsSpoofing"
            app:summary="@string/gps_spoofing_summary"
            app:title="@string/gps_spoofing_switch" />
        <Preference
            app:icon="@drawable/ic_info"
            app:key="gpsSpoofingNotice"
            app:selectable="false"
            app:summary="@string/gps_spoofing_navigation_notice"
            app:title="@string/gps_spoofing_navigation_title" />
        <Preference
            app:isPreferenceVisible="false"
            app:key="gpsSpoofingRemove"
            app:summary="@string/gps_spoofing_remove_summary"
            app:title="@string/gps_spoofing_remove" />
        <EditTextPreference
            app:dialogMessage="@string/gps_spoofing_coordinates_help"
            app:key="gpsCoordinates"
            app:title="@string/gps_spoofing_coordinates"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:defaultValue="https://ipapi.co/json/"
            app:dialogMessage="@string/gps_spoofing_lookup_help"
            app:key="gpsLookupUrl"
            app:title="@string/gps_spoofing_lookup"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>
</PreferenceScreen>
