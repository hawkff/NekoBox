<?xml version="1.0" encoding="utf-8"?>
<!-- A Settings page, opened from its row (screen_inbound) in global_preferences.xml. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <EditTextPreference
        app:icon="@drawable/ic_directions_boat"
        app:key="mixedPort"
        app:title="@string/port_proxy"
        app:useSimpleSummaryProvider="true" />
    <SwitchPreference
        app:defaultValue="false"
        app:key="appendHttpProxy"
        app:summary="@string/append_http_proxy_sum"
        app:title="@string/append_http_proxy" />
    <EditTextPreference
        app:key="httpProxyBypass"
        app:summary="@string/http_proxy_bypass_sum"
        app:title="@string/http_proxy_bypass" />
    <SwitchPreference
        app:icon="@drawable/ic_nat"
        app:key="allowAccess"
        app:summary="@string/allow_access_sum"
        app:title="@string/allow_access" />
    <SwitchPreference
        app:defaultValue="false"
        app:key="requireProxyInVPN"
        app:summary="@string/require_proxy_in_vpn_sum"
        app:title="@string/require_proxy_in_vpn" />
    <SwitchPreference
        app:defaultValue="false"
        app:key="proxyModeInboundAuth"
        app:summary="@string/proxy_mode_inbound_auth_sum"
        app:title="@string/proxy_mode_inbound_auth" />
</PreferenceScreen>
