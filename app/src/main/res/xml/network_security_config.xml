<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false"/>
    <!-- The connection check's hosts may chain to ISRG Root X1, which Android trusts only from 7.1.1. -->
    <domain-config>
        <domain includeSubdomains="true">bash.ws</domain>
        <domain includeSubdomains="true">ipleak.net</domain>
        <domain includeSubdomains="true">cloudflare.com</domain>
        <domain includeSubdomains="true">dnscheck.tools</domain>
        <domain includeSubdomains="true">proxycheck.io</domain>
        <domain includeSubdomains="true">torproject.org</domain>
        <domain includeSubdomains="true">raw.githubusercontent.com</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
        </trust-anchors>
    </domain-config>
</network-security-config>
