<?xml version="1.0" encoding="utf-8"?>
<!-- A Settings page, opened from its row (screen_connection) in global_preferences.xml. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <SwitchPreference
        app:defaultValue="false"
        app:icon="@drawable/ic_phonelink_ring"
        app:key="isAutoConnect"
        app:summary="@string/auto_connect_summary"
        app:title="@string/auto_connect" />
    <xyz.nekobyte.nekobox.ui.ChoicePreference
        app:defaultValue="vpn"
        app:entries="@array/service_modes"
        app:entrySummaries="@array/service_mode_summaries"
        app:entryValues="@array/service_mode_values"
        app:icon="@drawable/ic_developer_mode"
        app:key="serviceMode"
        app:title="@string/service_mode"
        app:useSimpleSummaryProvider="true" />
    <xyz.nekobyte.nekobox.ui.ChoicePreference
        app:defaultValue="0"
        app:entries="@array/tun_implementation"
        app:entrySummaries="@array/tun_implementation_summaries"
        app:entryValues="@array/int_array_3"
        app:icon="@drawable/ic_flip_camera_android"
        app:key="tunImplementation"
        app:title="@string/tun_implementation"
        app:useSimpleSummaryProvider="true" />
    <xyz.nekobyte.nekobox.ui.MTUPreference
        app:defaultValue="1500"
        app:entries="@array/mtu_entries"
        app:entrySummaries="@array/mtu_summaries"
        app:entryValues="@array/mtu_values"
        app:icon="@drawable/ic_public"
        app:key="mtu"
        app:title="@string/mtu" />
    <SwitchPreference
        app:icon="@drawable/ic_data_usage"
        app:key="meteredNetwork"
        app:summary="@string/metered_summary"
        app:title="@string/metered" />
    <SwitchPreference
        app:defaultValue="true"
        app:icon="@drawable/ic_developer_board"
        app:key="acquireWakeLock"
        app:summary="@string/acquire_wake_lock_summary"
        app:title="@string/acquire_wake_lock" />
    <SwitchPreference
        app:defaultValue="true"
        app:icon="@drawable/ic_flip_camera_android"
        app:key="networkChangeResetConnections"
        app:title="@string/network_change_reset_connections"
        app:useSimpleSummaryProvider="true" />
    <SwitchPreference
        app:key="wakeResetConnections"
        app:title="@string/wake_reset_connections"
        app:useSimpleSummaryProvider="true" />
    <SwitchPreference
        app:defaultValue="false"
        app:icon="@drawable/ic_legend_toggle"
        app:key="networkAutomation"
        app:summary="@string/network_automation_summary"
        app:title="@string/network_automation" />
    <Preference
        app:dependency="networkAutomation"
        app:key="networkAutomationRules"
        app:title="@string/network_automation_rules" />
</PreferenceScreen>
