<?xml version="1.0" encoding="utf-8"?>
<!-- A Settings page, opened from its row (screen_appearance) in global_preferences.xml. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <xyz.nekobyte.nekobox.ui.ThemePickerPreference
        android:title="@string/theme"
        app:icon="@drawable/ic_palette"
        app:key="appTheme" />
    <xyz.nekobyte.nekobox.ui.ChoicePreference
        app:defaultValue="0"
        app:entries="@array/night_mode"
        app:entryValues="@array/int_array_4"
        app:icon="@drawable/ic_light_mode"
        app:key="nightTheme"
        app:title="@string/night_mode"
        app:useSimpleSummaryProvider="true" />
    <SwitchPreference
        app:defaultValue="false"
        app:key="liquidGlass"
        app:title="@string/liquid_glass" />
    <xyz.nekobyte.nekobox.ui.ChoicePreference
        app:defaultValue=""
        app:entries="@array/language_entries"
        app:entryValues="@array/language_values"
        app:icon="@drawable/ic_translate"
        app:key="appLanguage"
        app:title="@string/language"
        app:useSimpleSummaryProvider="true" />
    <SwitchPreference
        app:key="showBottomBar"
        app:summary="@string/show_bottom_bar_sum"
        app:title="@string/show_bottom_bar" />
    <SwitchPreference
        app:defaultValue="true"
        app:icon="@drawable/ic_center_focus_weak"
        app:key="alwaysShowAddress"
        app:summary="@string/always_show_address_sum"
        app:title="@string/always_show_address" />
    <SwitchPreference
        app:defaultValue="true"
        app:key="confirmProfileDelete"
        app:title="@string/confirm_profile_delete" />
    <SwitchPreference
        app:key="hideFromRecentApps"
        app:title="@string/hide_from_recent_apps" />
</PreferenceScreen>
