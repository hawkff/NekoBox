<?xml version="1.0" encoding="utf-8"?>
<!-- A Settings page, opened from its row (screen_route) in global_preferences.xml. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <SwitchPreference
        app:icon="@drawable/ic_apps"
        app:key="proxyApps"
        app:summary="@string/proxied_apps_summary"
        app:title="@string/proxied_apps" />
    <SwitchPreference
        app:icon="@drawable/ic_legend_toggle"
        app:key="bypassLan"
        app:summary="@string/bypass_lan_summary"
        app:title="@string/route_opt_bypass_lan" />
    <SwitchPreference
        app:key="bypassLanInCore"
        app:summary="@string/bypass_lan_in_core_summary"
        app:title="@string/bypass_lan_in_core" />
    <xyz.nekobyte.nekobox.ui.ChoicePreference
        app:defaultValue="1"
        app:entries="@array/traffic_sniffing_values"
        app:entrySummaries="@array/traffic_sniffing_summaries"
        app:entryValues="@array/int_array_3"
        app:icon="@drawable/ic_manage_search"
        app:key="trafficSniffing"
        app:title="@string/traffic_sniffing" />
    <SwitchPreference
        app:icon="@drawable/ic_wrap_text"
        app:key="resolveDestination"
        app:summary="@string/resolve_destination_summary"
        app:title="@string/resolve_destination" />
    <xyz.nekobyte.nekobox.ui.ChoicePreference
        app:defaultValue="0"
        app:entries="@array/ipv6_mode"
        app:entryValues="@array/int_array_4"
        app:icon="@drawable/ic_looks_6"
        app:key="ipv6Mode"
        app:title="@string/ipv6"
        app:useSimpleSummaryProvider="true" />
    <xyz.nekobyte.nekobox.ui.ChoicePreference
        app:defaultValue="0"
        app:entries="@array/rules_dat_provider"
        app:entrySummaries="@array/rules_provider_summaries"
        app:entryValues="@array/int_array_5"
        app:icon="@drawable/ic_rule_folder"
        app:key="rulesProvider"
        app:title="@string/route_rules_provider"
        app:useSimpleSummaryProvider="true" />
    <EditTextPreference
        app:defaultValue="https://github.com/SagerNet/sing-geosite/releases/latest/download/geosite.db"
        app:key="rulesGeositeUrl"
        app:title="@string/rules_geosite_url"
        app:useSimpleSummaryProvider="true" />
    <EditTextPreference
        app:defaultValue="https://github.com/SagerNet/sing-geoip/releases/latest/download/geoip.db"
        app:key="rulesGeoipUrl"
        app:title="@string/rules_geoip_url"
        app:useSimpleSummaryProvider="true" />
    <EditTextPreference
        app:defaultValue="0"
        app:icon="@drawable/ic_shutter_speed"
        app:key="rulesUpdateInterval"
        app:summary="@string/ruleset_update_interval_summary"
        app:title="@string/ruleset_update_interval" />
</PreferenceScreen>
