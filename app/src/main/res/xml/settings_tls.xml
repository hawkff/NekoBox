<?xml version="1.0" encoding="utf-8"?>
<!-- A Settings page, opened from its row (screen_tls) in global_preferences.xml. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <SwitchPreference
        app:icon="@drawable/ic_lock_open"
        app:key="globalAllowInsecure"
        app:summary="@string/global_allow_insecure_summary"
        app:title="@string/global_allow_insecure" />
    <SwitchPreference
        app:key="allowInsecureOnRequest"
        app:title="@string/allow_insecure_on_request_sum" />
    <xyz.nekobyte.nekobox.ui.ChoicePreference
        app:defaultValue="1.2"
        app:entries="@array/app_tls_version"
        app:entryValues="@array/app_tls_version"
        app:key="appTLSVersion"
        app:title="@string/app_tls_version"
        app:useSimpleSummaryProvider="true" />
    <PreferenceCategory app:title="@string/fragment_settings">
        <SwitchPreference
            app:key="enableTLSFragment"
            app:summary="@string/enable_tls_fragment_sum"
            app:title="@string/enable_tls_fragment" />
    </PreferenceCategory>
</PreferenceScreen>
