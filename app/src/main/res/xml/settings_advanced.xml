<?xml version="1.0" encoding="utf-8"?>
<!-- A Settings page, opened from its row (screen_advanced) in global_preferences.xml. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <SwitchPreference
        app:defaultValue="false"
        app:icon="@drawable/ic_bug_report"
        app:key="helpToImprove"
        app:summary="@string/help_to_improve_summary"
        app:title="@string/help_to_improve" />
    <xyz.nekobyte.nekobox.ui.ChoicePreference
        app:defaultValue="0"
        app:entries="@array/log_level"
        app:entryValues="@array/int_array_5"
        app:icon="@drawable/ic_bug_report"
        app:key="logLevel"
        app:title="@string/log_level"
        app:useSimpleSummaryProvider="true" />
    <Preference
        app:key="logBufSize"
        app:title="@string/log_buffer_size" />
    <xyz.nekobyte.nekobox.ui.EditConfigPreference
        app:icon="@drawable/ic_layers"
        app:key="globalCustomConfig"
        app:title="@string/custom_config"
        app:useSimpleSummaryProvider="true" />
    <xyz.nekobyte.nekobox.ui.UrlTestPreference
        app:defaultValue="http://www.gstatic.com/generate_204"
        app:icon="@drawable/ic_cast_connected"
        app:key="connectionTestURL"
        app:title="@string/connection_test_url"
        app:useSimpleSummaryProvider="true" />
    <Preference
        app:icon="@drawable/ic_undo"
        app:key="resetSettings"
        app:title="@string/reset_settings" />
    <Preference
        app:icon="@drawable/ic_delete"
        app:key="clearCache"
        app:summary="@string/clear_cache_summary"
        app:title="@string/clear_cache" />
</PreferenceScreen>
