<?xml version="1.0" encoding="utf-8"?>
<!--
  The settings hub: one row per page. A row opens its page's own file (SettingsPages), so neither the
  hub nor a page inflates the preferences of every page. Keep screen keys stable; SettingsFragment
  restores the open page from them.
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceScreen
        app:icon="@drawable/ic_palette"
        app:key="screen_appearance"
        app:summary="@string/settings_appearance_summary"
        app:title="@string/settings_appearance"
        app:fragment="xyz.nekobyte.nekobox.ui.SettingsPreferenceFragment" />

    <PreferenceScreen
        app:icon="@drawable/ic_router"
        app:key="screen_connection"
        app:summary="@string/settings_connection_summary"
        app:title="@string/settings_connection"
        app:fragment="xyz.nekobyte.nekobox.ui.SettingsPreferenceFragment" />

    <PreferenceScreen
        app:icon="@drawable/ic_security"
        app:key="screen_protection"
        app:summary="@string/settings_protection_summary"
        app:title="@string/settings_protection"
        app:fragment="xyz.nekobyte.nekobox.ui.SettingsPreferenceFragment" />

    <PreferenceScreen
        app:icon="@drawable/ic_alt_route"
        app:key="screen_route"
        app:summary="@string/settings_route_summary"
        app:title="@string/settings_routing"
        app:fragment="xyz.nekobyte.nekobox.ui.SettingsPreferenceFragment" />

    <PreferenceScreen
        app:icon="@drawable/ic_dns"
        app:key="screen_dns"
        app:summary="@string/settings_dns_summary"
        app:title="@string/cag_dns"
        app:fragment="xyz.nekobyte.nekobox.ui.SettingsPreferenceFragment" />

    <PreferenceScreen
        app:icon="@drawable/ic_nat"
        app:key="screen_inbound"
        app:summary="@string/settings_inbound_summary"
        app:title="@string/inbound_settings"
        app:fragment="xyz.nekobyte.nekobox.ui.SettingsPreferenceFragment" />

    <PreferenceScreen
        app:icon="@drawable/ic_enhanced_encryption"
        app:key="screen_tls"
        app:summary="@string/settings_tls_summary"
        app:title="@string/security_settings"
        app:fragment="xyz.nekobyte.nekobox.ui.SettingsPreferenceFragment" />

    <PreferenceScreen
        app:icon="@drawable/ic_speed"
        app:key="screen_notification"
        app:summary="@string/settings_notification_summary"
        app:title="@string/settings_notification"
        app:fragment="xyz.nekobyte.nekobox.ui.SettingsPreferenceFragment" />

    <PreferenceScreen
        app:icon="@drawable/ic_tune"
        app:key="screen_advanced"
        app:summary="@string/settings_advanced_summary"
        app:title="@string/settings_advanced"
        app:fragment="xyz.nekobyte.nekobox.ui.SettingsPreferenceFragment" />

</PreferenceScreen>
